@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<h1>Order desk</h1>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Open orders</h5>
                <p class="display-6">@Model.OpenOrderCount</p>
                <a asp-page="/Orders/Index" asp-route-status="Placed">View placed orders</a>
            </div>
        </div>
    </div>
</div>
