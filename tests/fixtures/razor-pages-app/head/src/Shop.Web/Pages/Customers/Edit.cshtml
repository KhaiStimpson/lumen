@page "{id:int}"
@model Shop.Web.Pages.Customers.EditModel
@{
    ViewData["Title"] = $"Edit {Model.DisplayName}";
}

<h1>Edit customer</h1>
<p class="text-muted">@Model.DisplayName</p>

<div class="row">
    <div class="col-lg-7">
        <form id="customer-edit-form" method="post" asp-route-id="@Model.Input.Id">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.Id" />

            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Bio" class="form-label"></label>
                <textarea asp-for="Input.Bio" class="form-control" rows="4"></textarea>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.IsAdmin" class="form-check-input" />
                <label asp-for="Input.IsAdmin" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>

    <div class="col-lg-5">
        <h2 class="h5">Notes</h2>
        <div id="customer-notes" data-customer-id="@Model.Input.Id" data-url="@Url.Page("./Edit", "Notes", new { id = Model.Input.Id })">
            <partial name="_CustomerNotes" model="Model.Notes" />
        </div>

        <form id="customer-note-form" class="mt-2">
            @Html.AntiForgeryToken()
            <textarea id="customer-note-body" class="form-control" rows="3" placeholder="Add a note"></textarea>
            <button type="submit" class="btn btn-sm btn-outline-primary mt-2">Add note</button>
        </form>
    </div>
</div>
