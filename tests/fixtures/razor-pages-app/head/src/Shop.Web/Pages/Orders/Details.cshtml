@page "{id:int}"
@model Shop.Web.Pages.Orders.DetailsModel
@{
    ViewData["Title"] = Model.Order.Number;
}

<h1>Order @Model.Order.Number</h1>

<dl class="row">
    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@Model.Order.Customer?.Name</dd>
    <dt class="col-sm-3">Placed</dt>
    <dd class="col-sm-9">@Model.Order.PlacedOn.ToString("f")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Order.Status</dd>
    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">@Model.Order.Total.ToString("C")</dd>
</dl>

<partial name="_OrderLines" model="Model.Order.Lines" />

<a asp-page="./Edit" asp-route-id="@Model.Order.Id" class="btn btn-primary">Edit</a>
<a asp-page="./Index" class="btn btn-link">Back to orders</a>
