<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Lumen.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lumen.App\Lumen.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\andrew-crm-58\**" LinkBase="fixtures/andrew-crm-58" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\andrew-crm-refactor\**" LinkBase="fixtures/andrew-crm-refactor" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\andrew-crm-audit\**" LinkBase="fixtures/andrew-crm-audit" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
