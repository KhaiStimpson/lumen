<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumen.App.App"
             Name="Kelpie Review"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Lumen/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent's own controls (switches, checkboxes, focus) take the Gauge accent and surfaces -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0A64C8" RegionColor="#FFFFFF" ErrorText="#B42318" />
        <ColorPaletteResources x:Key="Dark" Accent="#7CC0FF" RegionColor="#1E1E1E" ErrorText="#FF7B72" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Lumen/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
