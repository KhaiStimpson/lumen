<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumen.App.ViewModels"
        xmlns:views="using:Lumen.App.Views"
        x:Class="Lumen.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Lumen"
        Width="1480" Height="920" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">

  <Grid RowDefinitions="44,*">
    <!-- Title bar: identity, where you are, and a quiet go-to box. Drag area is the empty space. -->
    <Grid Name="TitleBar" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,150" Background="{DynamicResource Surface.Window}">
      <StackPanel Orientation="Horizontal" Spacing="9" Margin="16,0,18,0" VerticalAlignment="Center">
        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Accent}">
          <Path Data="{StaticResource Icon.Spark}" Fill="{DynamicResource Accent.OnAccent}" Width="12" Height="12" Stretch="Uniform" />
        </Border>
        <TextBlock Text="Lumen" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
        <Border Classes="pill" Padding="6,1" VerticalAlignment="Center">
          <TextBlock Text="Preview" FontSize="10" />
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  IsVisible="{Binding IsPullRequestOpen}">
        <Button Classes="ghost" Padding="6,3" Command="{Binding GoHomeCommand}" ToolTip.Tip="Open another pull request">
          <TextBlock Text="{Binding PullRequest.RepositoryLabel, FallbackValue=''}" Classes="secondary" FontSize="12.5" />
        </Button>
        <TextBlock Text="/" Classes="tertiary" VerticalAlignment="Center" />
        <TextBlock Text="{Binding PullRequest.NumberLabel, FallbackValue=''}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
        <TextBlock Text="{Binding PullRequest.Title, FallbackValue=''}" FontSize="12.5" MaxWidth="420"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>

      <Panel Grid.Column="3" Width="340" Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="{Binding IsPullRequestOpen}">
        <TextBox Name="GoToFile" Classes="search" Watermark="Go to file…" Text="{Binding GoToFileQuery}" />
        <Path Data="{StaticResource Icon.Search}" Stroke="{DynamicResource Text.Tertiary}" Classes="stroke"
              Width="12" Height="12" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
        <Border Classes="kbd" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False">
          <TextBlock Text="Ctrl K" />
        </Border>
      </Panel>

      <Button Name="ConnectionsButton" Grid.Column="4" Classes="ghost" Padding="7" Margin="0,0,2,0"
              Command="{Binding OpenConnectionsCommand}" ToolTip.Tip="Connections">
        <Path Data="{StaticResource Icon.Plug}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="14" Height="14" />
      </Button>

      <Button Grid.Column="5" Classes="ghost" Padding="7" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle light / dark">
        <Panel>
          <Path Data="{StaticResource Icon.Moon}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="14" Height="14" />
        </Panel>
      </Button>
    </Grid>

    <ContentControl Grid.Row="1" Content="{Binding Current}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:OpenPullRequestViewModel">
          <views:OpenPullRequestView />
        </DataTemplate>
        <DataTemplate DataType="vm:PullRequestViewModel">
          <views:PullRequestView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- Connections: a modal card over the current view; click outside or Escape to close. -->
    <Panel Name="ConnectionsOverlay" Grid.Row="1" IsVisible="{Binding IsConnectionsOpen}">
      <Border Name="ConnectionsScrim" Background="{DynamicResource Surface.Window}" Opacity="0.72" />
      <ScrollViewer Name="ConnectionsScroller" VerticalScrollBarVisibility="Auto">
      <Border Name="ConnectionsCard" Classes="card" Width="520" Margin="0,48,0,24" Padding="28,24" VerticalAlignment="Top" HorizontalAlignment="Center"
              BoxShadow="0 12 40 0 #24000000">
        <StackPanel Spacing="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="Connections" />
              <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                         Text="Optional. Reviews never wait on these: without them the deterministic review is unchanged." />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Padding="7" VerticalAlignment="Top"
                    Command="{Binding CloseConnectionsCommand}" ToolTip.Tip="Close (Esc)">
              <Path Data="{StaticResource Icon.Close}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="11" Height="11" />
            </Button>
          </Grid>
          <views:ConnectionsView DataContext="{Binding Connections}" />
        </StackPanel>
      </Border>
      </ScrollViewer>
    </Panel>
  </Grid>
</Window>
