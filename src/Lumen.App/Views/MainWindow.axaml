<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumen.App.ViewModels"
        xmlns:views="using:Lumen.App.Views"
        x:Class="Lumen.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Kelpie Review"
        Icon="/Assets/kelpie.ico"
        Width="1480" Height="920" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38">

  <Grid RowDefinitions="38,*">
    <!-- Title bar (Gauge window chrome: bg-2 with a line border): the Kelpie icon, where you are, and the go-to box.
         Drag area is the empty space. -->
    <Border Grid.ColumnSpan="7" Classes="chrome" BorderThickness="0,0,0,1" />
    <Grid Name="TitleBar" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,150">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,16,0" VerticalAlignment="Center">
        <Image Source="/Assets/kelpie-icon-64.png" Width="18" Height="18" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="Kelpie Review" Classes="h3" FontSize="13" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  IsVisible="{Binding IsPullRequestOpen}">
        <Button Classes="ghost" Padding="6,3" Command="{Binding GoHomeCommand}" ToolTip.Tip="Open another pull request">
          <TextBlock Text="{Binding PullRequest.RepositoryLabel, FallbackValue=''}" Classes="secondary" FontSize="12.5" />
        </Button>
        <TextBlock Text="/" Classes="tertiary" VerticalAlignment="Center" />
        <TextBlock Text="{Binding PullRequest.NumberLabel, FallbackValue=''}" Classes="h3" FontSize="12.5" VerticalAlignment="Center" />
        <TextBlock Text="{Binding PullRequest.Title, FallbackValue=''}" FontSize="12.5" MaxWidth="420"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Command palette (Ctrl+K, TDD §30): go to file, go to pull request, actions with their shortcuts -->
      <Panel Name="PalettePanel" Grid.Column="3" Width="340" Margin="0,0,12,0" VerticalAlignment="Center">
        <TextBox Name="GoToFile" Classes="search" PlaceholderText="Go to file, pull request or command…" Text="{Binding Palette.Query}" />
        <Path Data="{StaticResource Icon.Search}" Stroke="{DynamicResource Text.Tertiary}" Classes="stroke"
              Width="12" Height="12" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
        <Border Classes="kbd" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False">
          <TextBlock Text="Ctrl K" />
        </Border>
        <Popup Name="PalettePopup" PlacementTarget="GoToFile" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
               IsOpen="{Binding Palette.IsOpen}" IsLightDismissEnabled="False" WindowManagerAddShadowHint="False">
          <Border Classes="card" Width="600" MaxHeight="440" Background="{DynamicResource Surface.Chrome}" BorderBrush="{DynamicResource Border.Strong}"
                  CornerRadius="6" BoxShadow="0 12 32 0 #88000000" Padding="4">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Classes="caption tertiary" Text="{Binding Palette.Hint}" Margin="10,4,10,6" />
              <ScrollViewer Grid.Row="1">
                <ItemsControl Name="PaletteItems" ItemsSource="{Binding Palette.Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaletteItemViewModel">
                      <Button Classes="row" Classes.current="{Binding IsSelected}" Padding="10,6"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Palette.RunCommand, FallbackValue={x:Null}}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption tertiary" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Detail, Converter={x:Static views:Converters.NotEmpty}}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Classes="caption tertiary" Text="{Binding KindLabel}" VerticalAlignment="Center" />
                          <Border Grid.Column="2" Classes="kbd" VerticalAlignment="Center" IsVisible="{Binding HasShortcut}">
                            <TextBlock Text="{Binding Shortcut}" />
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Popup>
      </Panel>

      <Button Name="SettingsButton" Grid.Column="4" Classes="ghost" Padding="7" Margin="0,0,2,0"
              Command="{Binding OpenReviewSettingsCommand}" ToolTip.Tip="Settings">
        <Path Data="{StaticResource Icon.Sliders}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="14" Height="14" />
      </Button>

      <Button Grid.Column="5" Classes="ghost" Padding="7" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Toggle light / dark">
        <Panel>
          <Path Data="{StaticResource Icon.Moon}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="14" Height="14" />
        </Panel>
      </Button>
    </Grid>

    <ContentControl Grid.Row="1" Content="{Binding Current}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:InboxViewModel">
          <views:InboxView />
        </DataTemplate>
        <DataTemplate DataType="vm:PullRequestViewModel">
          <views:PullRequestView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- Settings: a modal card over the current view; click outside or Escape to close (docs/design/settings-overlay.md). -->
    <Panel Name="SettingsOverlay" Grid.Row="1" IsVisible="{Binding IsSettingsOpen}">
      <Border Name="SettingsScrim" Background="{DynamicResource Gauge.Scrim}" />
      <Panel Name="SettingsHost" Background="Transparent">
        <Border Name="SettingsCard" Classes="card" Width="760" MaxHeight="680" Margin="24,32,24,28" HorizontalAlignment="Center"
                BoxShadow="0 12 32 0 #88000000">
          <views:SettingsView />
        </Border>
      </Panel>
    </Panel>
  </Grid>
</Window>
