<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.App.ViewModels"
             xmlns:views="using:Lumen.App.Views"
             xmlns:diff="using:Lumen.App.Diff"
             x:Class="Lumen.App.Views.PullRequestView"
             x:DataType="vm:PullRequestViewModel">
  <Panel>
    <Grid Name="Layout" ColumnDefinitions="284,*,344">

      <!-- ===================== Left: pull request + files ===================== -->
      <Border Classes="pane" BorderThickness="0,1,1,0" CornerRadius="0,10,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <StackPanel Margin="18,18,18,14" Spacing="6">
            <TextBlock Classes="section" Text="PULL REQUEST" />
            <TextBlock TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis" LineHeight="21">
              <Run Text="{Binding NumberLabel}" FontWeight="Bold" FontSize="15" />
              <Run Text=" " />
              <Run Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
              <Border Classes="pill open" IsVisible="{Binding StateLabel, Converter={x:Static views:Converters.NotEmpty}}">
                <TextBlock Text="{Binding StateLabel}" />
              </Border>
              <TextBlock Classes="caption" VerticalAlignment="Center">
                <Run Text="by " /><Run Text="{Binding Author}" FontWeight="Medium" />
              </TextBlock>
            </StackPanel>
            <TextBlock Classes="caption tertiary" Text="{Binding BranchLabel}" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <Border Grid.Row="1" Classes="divider" />

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="18,14,18,8">
            <TextBlock Classes="h3" Text="Files changed" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Files.Count}" />
          </Grid>

          <TreeView Grid.Row="3" Name="FileTree" ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}"
                    Margin="6,0,6,0" Background="Transparent">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:FileTreeNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:FileTreeNode" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3,6,3">
                  <Path Data="{StaticResource Icon.Folder}" Stroke="{DynamicResource Text.Tertiary}" Classes="stroke"
                        Width="12" Height="12" Margin="0,0,8,0" IsVisible="{Binding IsFolder}" />
                  <Path Data="{StaticResource Icon.File}" Stroke="{DynamicResource Text.Tertiary}" Classes="stroke"
                        Width="12" Height="12" Margin="0,0,8,0" IsVisible="{Binding !IsFolder}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource Text.Primary}" />
                  <Path Grid.Column="2" Data="{StaticResource Icon.Deviation}" Fill="{DynamicResource Marker.Deviation}"
                        Width="10" Height="10" Stretch="Uniform" Margin="6,0,6,0"
                        IsVisible="{Binding File.HasReviewPoints, FallbackValue=False}" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsFolder}">
                    <TextBlock Classes="added" Text="{Binding File.AdditionsLabel, FallbackValue=''}" />
                    <TextBlock Classes="removed" Text="{Binding File.DeletionsLabel, FallbackValue=''}" />
                  </StackPanel>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <!-- Generated / mechanical changes are collapsed, not hidden -->
          <StackPanel Grid.Row="4" Margin="10,6,10,12" IsVisible="{Binding GeneratedFiles.Count, Converter={x:Static views:Converters.IsPositive}}">
            <Button Classes="row" Command="{Binding ToggleGeneratedCommand}">
              <Grid ColumnDefinitions="Auto,*">
                <Path Data="{StaticResource Icon.Generated}" Stroke="{DynamicResource Text.Tertiary}" Classes="stroke" Width="12" Height="12" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding GeneratedSummary}" />
              </Grid>
            </Button>
            <ItemsControl ItemsSource="{Binding GeneratedFiles}" IsVisible="{Binding ShowGenerated}" MaxHeight="220">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FileEntryViewModel">
                  <Button Classes="row" Padding="10,4"
                          Command="{Binding $parent[views:PullRequestView].((vm:PullRequestViewModel)DataContext).SelectFileCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontSize="12" Classes="secondary" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Classes="caption tertiary" Text="{Binding MechanicalReason}" Margin="8,0,0,0" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===================== Center: code ===================== -->
      <Grid Grid.Column="1" Name="Center" RowDefinitions="Auto,Auto,*" IsVisible="{Binding !IsExamining}">
        <!-- Guided review header -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="22,14,22,10">
          <Grid ColumnDefinitions="Auto,Auto,Auto" ClipToBounds="True">
            <TextBlock Classes="h2" Text="{Binding SelectedFile.Name, FallbackValue='Loading…'}" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1" Classes="pill" Margin="10,0,8,0" VerticalAlignment="Center"
                    IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding SelectedFile.KindLabel, FallbackValue=''}" />
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="added" Text="{Binding SelectedFile.AdditionsLabel, FallbackValue=''}" />
              <TextBlock Classes="removed" Text="{Binding SelectedFile.DeletionsLabel, FallbackValue=''}" />
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="1" Classes="caption tertiary" Margin="0,3,0,0" Text="{Binding SelectedFile.Directory, FallbackValue=''}" TextTrimming="CharacterEllipsis" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Classes="subtle" Padding="8,6" Command="{Binding PreviousPointCommand}" ToolTip.Tip="Previous review point (K)">
              <Path Data="{StaticResource Icon.ChevronLeft}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="12" Height="12" />
            </Button>
            <Border Classes="card" Padding="12,5" CornerRadius="7">
              <TextBlock FontSize="12" FontWeight="Medium">
                <Run Text="Review point " Foreground="{DynamicResource Text.Secondary}" /><Run Text="{Binding PositionLabel}" />
              </TextBlock>
            </Border>
            <Button Classes="subtle" Padding="8,6" Command="{Binding NextPointCommand}" ToolTip.Tip="Next review point (J)">
              <Path Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="12" Height="12" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right" Margin="0,4,2,0">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" IsVisible="{Binding IsAnalysing}" Name="AnalysingDot" VerticalAlignment="Center" />
            <TextBlock Classes="caption tertiary" Text="{Binding Status}" MaxWidth="340" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <!-- Review settings changed since this analysis: offer to re-run it, never run it unasked. -->
        <Border Name="ReanalyseBanner" Grid.Row="1" Background="{DynamicResource Accent.Soft}" CornerRadius="{StaticResource Radius.Card}"
                Margin="16,0,16,10" Padding="14,8,8,8" IsVisible="{Binding NeedsReanalysis}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Review settings changed since this pull request was analysed." />
            <Button Grid.Column="1" Classes="primary" Content="{Binding ReanalyseLabel}" Command="{Binding ReanalyseCommand}" />
          </Grid>
        </Border>

        <Border Grid.Row="2" Classes="card" Margin="16,0,16,16" ClipToBounds="True">
          <Panel>
            <diff:DiffEditor Name="Editor" Diff="{Binding CurrentDiff}" Markers="{Binding Markers}" FocusRange="{Binding FocusRange}" />
            <!-- Mechanical file without a diff in the fixture, or still loading -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                        IsVisible="{Binding CurrentDiff.IsEmpty, FallbackValue=True}">
              <TextBlock Classes="h3" HorizontalAlignment="Center"
                         Text="{Binding SelectedFile.MechanicalReason, FallbackValue='Loading…', TargetNullValue='No textual changes'}" />
              <TextBlock Classes="caption" HorizontalAlignment="Center" Text="Nothing to review line by line." />
            </StackPanel>
          </Panel>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="1" Margin="32" VerticalAlignment="Top" Classes="card" Padding="16,12"
                BorderBrush="{DynamicResource Severity.High}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="4">
            <TextBlock Classes="h3" Text="Couldn't finish loading this pull request" />
            <TextBlock Classes="body secondary" Text="{Binding Error}" />
            <TextBlock Classes="caption" IsVisible="{Binding IsAuthenticationError}" Text="Sign in with the GitHub CLI: run  gh auth login  then refresh." />
            <Button Classes="subtle" Content="Retry" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ===================== Right: review focus / precedent / patterns ===================== -->
      <Border Grid.Column="2" Name="RightPane" Classes="pane" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0" IsVisible="{Binding !IsExamining}">
        <ScrollViewer>
          <StackPanel Margin="18,18,18,18" Spacing="22">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h3" Text="Review focus" />
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ReviewFocusLabel}" />
              </Grid>
              <TextBlock Classes="caption tertiary" TextWrapping="Wrap" IsVisible="{Binding IsAnalysing}"
                         Text="Comparing this change with repository precedent…" />
              <ItemsControl ItemsSource="{Binding ReviewPoints}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReviewPointViewModel">
                    <Button Classes="row" Classes.current="{Binding IsCurrent}" Margin="-8,0" Padding="10,9"
                            Command="{Binding $parent[views:PullRequestView].((vm:PullRequestViewModel)DataContext).SelectPointCommand}"
                            CommandParameter="{Binding}" Opacity="{Binding IsDismissed, Converter={x:Static views:Converters.DimIf}}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top" Margin="0,1,10,0"
                                Background="{Binding Kind, Converter={x:Static views:Converters.KindToBrush}}">
                          <Path Data="{Binding Kind, Converter={x:Static views:Converters.KindToIcon}}" Fill="White" Width="10" Height="10" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding LocationLabel}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" FontWeight="Medium" Text="{Binding StateLabel}"
                                     IsVisible="{Binding StateLabel, Converter={x:Static views:Converters.NotEmpty}}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="pill" VerticalAlignment="Top" Margin="8,0,0,0"
                                Classes.High="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=High}"
                                Classes.Medium="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Medium}"
                                Classes.Low="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Low}">
                          <TextBlock Text="{Binding Severity}" />
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasCurrentPoint}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h3" Text="Relevant precedent" />
                <Button Grid.Column="1" Classes="link" Content="Compare" Command="{Binding ShowPrecedentCommand}" CommandParameter="{x:Null}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding CurrentPoint.PrecedentExamples, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PrecedentExampleViewModel">
                    <Button Classes="row" Margin="-8,0" Padding="10,6"
                            Command="{Binding $parent[views:PullRequestView].((vm:PullRequestViewModel)DataContext).OpenSourceCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*">
                        <Path Data="{StaticResource Icon.File}" Stroke="{DynamicResource Accent}" Classes="stroke" Width="12" Height="12" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Medium" />
                          <TextBlock Classes="caption tertiary" Text="{Binding Directory}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding Conventions.Count, Converter={x:Static views:Converters.IsPositive}}">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="Patterns in this repository" />
                <TextBlock Classes="caption tertiary" Text="Observed in code near this change" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Conventions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConventionViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                      <TextBlock Text="{Binding Statement}" FontSize="12" TextWrapping="Wrap" Classes="secondary" Margin="0,0,10,0" />
                      <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Right">
                        <TextBlock Classes="caption" Text="{Binding Support}" HorizontalAlignment="Right" />
                        <Panel Width="56" Height="3" HorizontalAlignment="Right">
                          <Border Background="{DynamicResource Border.Subtle}" CornerRadius="2" />
                          <Border Background="{DynamicResource Marker.Verified}" CornerRadius="2" HorizontalAlignment="Left"
                                  Width="{Binding Strength, Converter={x:Static views:Converters.StrengthToWidth}}" />
                        </Panel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="6" Margin="0,4,0,0">
              <TextBlock Classes="section" Text="KEYBOARD" />
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,6">
                  <Border Classes="kbd"><TextBlock Text="J" /></Border><Border Classes="kbd"><TextBlock Text="K" /></Border>
                  <TextBlock Classes="caption" Text="next / previous" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,6">
                  <Border Classes="kbd"><TextBlock Text="↵" /></Border><TextBlock Classes="caption" Text="examine" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,6">
                  <Border Classes="kbd"><TextBlock Text="D" /></Border><TextBlock Classes="caption" Text="dismiss" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,6">
                  <Border Classes="kbd"><TextBlock Text="C" /></Border><TextBlock Classes="caption" Text="comment" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,6">
                  <Border Classes="kbd"><TextBlock Text="P" /></Border><TextBlock Classes="caption" Text="precedent" />
                </StackPanel>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ===================== Examine mode: replaces center + right ===================== -->
      <views:ExamineView Grid.Column="1" Grid.ColumnSpan="2" Name="Examine" IsVisible="{Binding IsExamining}" />
    </Grid>

    <!-- Precedent source viewer -->
    <Border Name="SourceScrim" Background="#33000000" IsVisible="{Binding SourcePreview, Converter={x:Static ObjectConverters.IsNotNull}}"
            PointerPressed="OnScrimPressed">
      <Border Classes="card" Margin="120,48" MaxWidth="1100" BoxShadow="0 18 60 0 #33000000" Name="SourceSheet">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,14,12,12">
            <Path Data="{StaticResource Icon.Book}" Stroke="{DynamicResource Compare.Precedent.Title}" Classes="stroke" Width="14" Height="14" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Classes="h3" Text="{Binding SourcePreview.FileName, FallbackValue=''}" />
              <TextBlock Classes="caption tertiary" Text="{Binding SourcePreview.Directory, FallbackValue=''}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="ghost" Padding="7" Command="{Binding CloseSourceCommand}" ToolTip.Tip="Close (Esc)">
              <Path Data="{StaticResource Icon.Close}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="11" Height="11" />
            </Button>
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0">
            <ScrollViewer Name="SourceScroll">
              <diff:CodeSnippet Name="SourceCode" Code="{Binding SourcePreview.Text, FallbackValue=''}" Path="{Binding SourcePreview.Path, FallbackValue=''}"
                                StartLine="{Binding SourcePreview.StartLine, FallbackValue=1}"
                                HighlightLines="{Binding SourcePreview.HighlightLines, FallbackValue={x:Null}}" HighlightBrushKey="Diff.Added.Bg" />
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>
    </Border>

    <!-- Quiet toast -->
    <Border Name="ToastHost" Classes="card" Padding="14,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
            BoxShadow="0 8 24 0 #22000000" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Toast}" FontSize="12.5" />
    </Border>
  </Panel>
</UserControl>
