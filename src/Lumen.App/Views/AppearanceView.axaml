<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.App.ViewModels"
             xmlns:views="using:Lumen.App.Views"
             x:Class="Lumen.App.Views.AppearanceView"
             x:DataType="vm:AppearanceViewModel">
  <!-- App-only preferences, saved to app.json. Both apply at once. -->
  <StackPanel Spacing="20">
    <StackPanel Spacing="2">
      <TextBlock Classes="h3" Text="Appearance" />
      <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="How Lumen looks on this machine." />
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Classes="body" Text="Theme" />
        <TextBlock Classes="caption tertiary" TextWrapping="Wrap" Text="System follows Windows." />
      </StackPanel>
      <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <RadioButton Name="ThemeSystem" Classes="segment" GroupName="Theme" Content="System"
                       IsChecked="{Binding Theme, Converter={x:Static views:Converters.EnumEquals}, ConverterParameter=System}" />
          <RadioButton Name="ThemeLight" Classes="segment" GroupName="Theme" Content="Light"
                       IsChecked="{Binding Theme, Converter={x:Static views:Converters.EnumEquals}, ConverterParameter=Light}" />
          <RadioButton Name="ThemeDark" Classes="segment" GroupName="Theme" Content="Dark"
                       IsChecked="{Binding Theme, Converter={x:Static views:Converters.EnumEquals}, ConverterParameter=Dark}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Classes="body" Text="Motion" />
        <TextBlock Classes="caption tertiary" TextWrapping="Wrap" Text="Reduced turns off sliding and fading between review points." />
      </StackPanel>
      <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <RadioButton Name="MotionSystem" Classes="segment" GroupName="Motion" Content="System"
                       IsChecked="{Binding Motion, Converter={x:Static views:Converters.EnumEquals}, ConverterParameter=System}" />
          <RadioButton Name="MotionReduced" Classes="segment" GroupName="Motion" Content="Reduced"
                       IsChecked="{Binding Motion, Converter={x:Static views:Converters.EnumEquals}, ConverterParameter=Reduced}" />
          <RadioButton Name="MotionFull" Classes="segment" GroupName="Motion" Content="Full"
                       IsChecked="{Binding Motion, Converter={x:Static views:Converters.EnumEquals}, ConverterParameter=Full}" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
