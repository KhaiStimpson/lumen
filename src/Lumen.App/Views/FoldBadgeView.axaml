<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.App.ViewModels"
             xmlns:views="using:Lumen.App.Views"
             x:Class="Lumen.App.Views.FoldBadgeView"
             x:DataType="vm:FoldBadgeViewModel"
             FontFamily="{StaticResource UiFont}">
  <!-- A folded hunk behind one line (docs/overhaul.md, Collapsing). Two kinds, labelled differently: "Mechanical · Proven ✓"
       with a solid edge, and "Boilerplate · Not verified" with a dashed edge. Opening it always shows every line. -->
  <Border Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
          CornerRadius="{StaticResource Radius.Card}" Padding="0,0,6,0" HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
      <!-- Leading edge: solid for proven, dashed for summarised -->
      <Panel Width="3" Margin="0,0,2,0">
        <Border Background="{DynamicResource Gauge.Ok}" IsVisible="{Binding IsMechanical}" />
        <Rectangle Stroke="{DynamicResource Gauge.Warn}" StrokeThickness="3" StrokeDashArray="1.2,1" IsVisible="{Binding IsBoilerplate}" />
      </Panel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Margin="0,5" FontWeight="SemiBold"
                 Foreground="{DynamicResource Text.Primary}">
        <Run Text="{Binding KindLabel}" /><Run Text="{Binding IsMechanical, Converter={x:Static views:Converters.CheckIf}}" Foreground="{DynamicResource Gauge.Ok}" />
      </TextBlock>
      <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis">
        <Run Text="{Binding Reason}" Foreground="{DynamicResource Text.Secondary}" />
        <Run Text="  ·  " Foreground="{DynamicResource Text.Tertiary}" />
        <Run Text="{Binding LinesLabel}" Foreground="{DynamicResource Text.Tertiary}" />
      </TextBlock>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="{Binding HasGroup}">
        <Button Classes="ghost" Padding="5" Command="{Binding PreviousCommand}" IsHitTestVisible="{Binding HasPrevious}" Opacity="{Binding !HasPrevious, Converter={x:Static views:Converters.DimIf}}" ToolTip.Tip="Previous in this group">
          <Path Data="{StaticResource Icon.ChevronLeft}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="10" Height="10" />
        </Button>
        <TextBlock Classes="caption tertiary" Text="{Binding GroupLabel}" VerticalAlignment="Center" ToolTip.Tip="{Binding GroupTitle}" />
        <Button Classes="ghost" Padding="5" Command="{Binding NextCommand}" IsHitTestVisible="{Binding HasNext}" Opacity="{Binding !HasNext, Converter={x:Static views:Converters.DimIf}}" ToolTip.Tip="Next in this group">
          <Path Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Text.Secondary}" Classes="stroke" Width="10" Height="10" />
        </Button>
      </StackPanel>
      <Button Grid.Column="4" Classes="link" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" VerticalAlignment="Center"
              ToolTip.Tip="Open or close the folded lines (O)" />
    </Grid>
  </Border>
</UserControl>
