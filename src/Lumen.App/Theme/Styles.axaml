<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typography -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Body}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.added">
    <Setter Property="Foreground" Value="{DynamicResource Diff.Added.Sign}" />
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBlock.removed">
    <Setter Property="Foreground" Value="{DynamicResource Diff.Removed.Sign}" />
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource Surface.Pane}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
  </Style>
  <!-- Chrome: title bar, nav rail, status bar, table headers (Gauge bg-2) -->
  <Style Selector="Border.chrome">
    <Setter Property="Background" Value="{DynamicResource Surface.Chrome}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
  </Style>

  <!-- Tags and severity. Gauge has no filled badges: a tag is a quiet outlined word, and severity is always a word,
       coloured only for critical and warning (Low is plain text). -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="Border.pill.High, Border.pill.Medium, Border.pill.Low, Border.pill.open">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.pill.High > TextBlock, Border.pill.Medium > TextBlock, Border.pill.Low > TextBlock, Border.pill.open > TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.pill.High > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Severity.High}" />
  </Style>
  <Style Selector="Border.pill.Medium > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Severity.Medium}" />
  </Style>
  <Style Selector="Border.pill.Low > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Severity.Low}" />
  </Style>
  <Style Selector="Border.pill.open > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Diff.Added.Sign}" />
  </Style>
  <!-- Key hint: Gauge g-kbd -->
  <Style Selector="Border.kbd">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Chrome}" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- A file in the slice's reading order: a quiet text button; the current one carries the selected treatment -->
  <Style Selector="Button.crumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="Button.crumb:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Gauge.Bg3}" />
  </Style>
  <Style Selector="Button.crumb.current /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Gauge.Sel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Gauge.SelEdge}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="Button.crumb.current TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Gauge.SelFg}" />
  </Style>
  <Style Selector="Run.hidden">
    <Setter Property="Foreground" Value="Transparent" />
  </Style>

  <!-- A key name in a list of keys (the inspector's Keys section): Gauge g-kbd type without the box -->
  <Style Selector="TextBlock.kbdtext">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Gauge g-callout: bg-2, line-2 border; the warn variant carries a warn leading edge and its words say why -->
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource Gauge.Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Gauge.Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.callout.warn">
    <Setter Property="BorderBrush" Value="{DynamicResource Gauge.Warn}" />
    <Setter Property="BorderThickness" Value="2,1,1,1" />
  </Style>

  <!-- Buttons: quiet by default, one obvious primary action -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="11,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="{DynamicResource Surface.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Active}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.OnAccent}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.OnAccent}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <!-- Content strings become TextBlocks, which the app-wide TextBlock style colours; restate it per button kind. -->
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Accent.OnAccent}" />
  </Style>
  <Style Selector="Button.subtle TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Hover}" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Chrome}" />
  </Style>
  <!-- Selection: fill, a 2px leading edge, and selection text colours (Gauge sel / sel-edge / sel-fg) -->
  <Style Selector="Button.row.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Selection.Edge}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="Button.row.current TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Selection.Text}" />
  </Style>
  <Style Selector="Button.row.current Border.pill.High > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Selection.Crit}" />
  </Style>
  <Style Selector="Button.row.current Border.pill.Medium > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Selection.Warn}" />
  </Style>

  <!-- Settings switches: no On/Off captions (the row says what it does), accent when on -->
  <Style Selector="ToggleSwitch.setting">
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleSwitch.setting:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>

  <!-- GitHub's per-file "Viewed" tick: a 14px box that fits a file-tree row (Fluent's is 32px tall), accent when ticked -->
  <Style Selector="CheckBox.viewed">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Box" Width="14" Height="14" CornerRadius="3" BorderThickness="1.25"
                BorderBrush="{DynamicResource Text.Tertiary}" Background="Transparent">
          <Path Name="Tick" Data="{StaticResource Icon.Verified}" Stroke="White" StrokeThickness="2"
                StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Margin="2.5" IsVisible="False" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.viewed:pointerover /template/ Border#Box">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="CheckBox.viewed:checked /template/ Border#Box">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="CheckBox.viewed:checked /template/ Path#Tick">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Settings navigation: Button.row, with the current section in the selected colour -->
  <Style Selector="Button.row.nav">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.row.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.row.nav.current">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.row.nav.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Active}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Content strings become TextBlocks, which the app-wide TextBlock style colours; restate the colour for them. -->
  <Style Selector="Button.row.nav TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="Button.row.nav.current TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <!-- Segmented control: picks one of two or three values (scope, theme, motion). Tabs are for navigation. -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.segmented > StackPanel">
    <Setter Property="Spacing" Value="0" />
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="Transparent" CornerRadius="0" Padding="10,2" MinHeight="22">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" TextElement.FontSize="12" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Surface.Control}" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Surface.Active}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.segment TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="RadioButton.segment:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <!-- Preset card: a choice that needs a sentence to explain it -->
  <Style Selector="RadioButton.preset">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Strong}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="12,10">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.preset:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
  </Style>
  <Style Selector="RadioButton.preset:checked /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Selection.Edge}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="11,9" />
  </Style>
  <Style Selector="RadioButton.preset:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Selection.Text}" />
  </Style>

  <!-- Stepper: numbers in settings, tabular and monospace so columns of values line up -->
  <Style Selector="NumericUpDown.stepper">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Width" Value="112" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="ClipValueToMinMax" Value="True" />
    <Setter Property="AllowSpin" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- At a limit the button only dims; the Fluent grey fill reads as pressed. -->
  <Style Selector="NumericUpDown.stepper /template/ ButtonSpinner /template/ RepeatButton:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Border.entry">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    <Setter Property="Padding" Value="8,2,2,2" />
  </Style>
  <Style Selector="Border.entry.fixed">
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.entry > StackPanel > TextBlock, Border.entry > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.entry.fixed > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <!-- Icons -->
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Path.stroke">
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- Tabs (RadioButtons styled as underline tabs) -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="Transparent" Padding="0,8" Margin="0,0,20,0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" TextElement.FontSize="12.5" TextElement.FontWeight="Medium" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#Root">
    <Setter Property="BorderBrush" Value="{DynamicResource Selection.Edge}" />
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="RadioButton.tab TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="RadioButton.tab:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="28,3,10,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Tree: quiet selection, not the platform accent -->
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Surface.Chrome}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Selection.Edge}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
  </Style>
  <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Selection.Text}" />
  </Style>

  <!-- Toggles (since last review, whitespace, split, reading order): a Gauge button; pressed = accent border and text -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="ToggleButton.chip TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface.Control}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ToggleButton.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Status bar (Gauge g-statusbar) -->
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource Surface.Chrome}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.statusbar TextBlock.ok">
    <Setter Property="Foreground" Value="{DynamicResource Diff.Added.Sign}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Nav rail (Gauge g-nav): sections down the left; the current one has the active fill -->
  <Style Selector="RadioButton.navitem">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="Transparent" CornerRadius="4" Height="30" Padding="9,0">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.navitem TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="RadioButton.navitem Path.stroke">
    <Setter Property="Stroke" Value="{DynamicResource Text.Tertiary}" />
  </Style>
  <Style Selector="RadioButton.navitem:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Surface.Control}" />
  </Style>
  <Style Selector="RadioButton.navitem:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="RadioButton.navitem:checked /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Surface.Active}" />
  </Style>
  <Style Selector="RadioButton.navitem:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.navitem:checked Path.stroke">
    <Setter Property="Stroke" Value="{DynamicResource Text.Primary}" />
  </Style>
  <!-- Count: fg-3 on chrome, fg-2 on hover/active (fg-3 drops below 4.5:1 on bg-3/bg-4) -->
  <Style Selector="RadioButton.navitem TextBlock.count">
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="RadioButton.navitem:pointerover TextBlock.count, RadioButton.navitem:checked TextBlock.count">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style Selector="RadioButton.navitem TextBlock.count.crit">
    <Setter Property="Foreground" Value="{DynamicResource Severity.High}" />
  </Style>
  <Style Selector="RadioButton.navitem:checked TextBlock.count.crit">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
</Styles>
