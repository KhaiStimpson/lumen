<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Window chrome for the extended client area (Avalonia 12 draws the decorations itself on Windows).
    Fluent's default draws a second window title over ours and four 45x30 caption buttons (one an invisible full-screen
    button) over the right of our title bar. This draws only minimise, maximise and close, the full height of our
    38 px title bar, and nothing else: the title bar itself is ours (MainWindow.axaml marks it as the drag area).
    The buttons are found by name (PART_*) and wired by WindowDrawnDecorations; their roles map them to the system
    caption buttons, so Windows 11 snap layouts still appear on the maximise button.
  -->

  <!-- Caption buttons: 46 wide, flat, hover on the chrome surface; close turns the Windows close red. -->
  <x:Double x:Key="CaptionButtonWidth">46</x:Double>

  <!-- Leave Focusable alone: a non-focusable caption button never raises Click on Windows. -->
  <ControlTheme x:Key="KelpieCaptionButton" TargetType="Button">
    <Setter Property="Width" Value="{StaticResource CaptionButtonWidth}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style Selector="^.close:pointerover">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="^.close:pressed">
      <Setter Property="Background" Value="#B3261A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="KelpieWindowDecorations" TargetType="WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="38" />
    <Setter Property="DefaultFrameThickness" Value="0" />
    <Setter Property="DefaultShadowThickness" Value="0" />
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>
          <WindowDrawnDecorationsContent.Overlay>
            <StackPanel Name="PART_OverlayPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Height="{TemplateBinding TitleBarHeight}" IsVisible="{TemplateBinding HasTitleBar}">
              <Button Name="PART_MinimizeButton" Theme="{StaticResource KelpieCaptionButton}"
                      WindowDecorationProperties.ElementRole="MinimizeButton" ToolTip.Tip="Minimise">
                <Path Data="M0,5.5 L10,5.5" Width="10" Height="10" Stretch="None" StrokeThickness="1" Stroke="{Binding $parent[Button].Foreground}" />
              </Button>
              <Button Name="PART_MaximizeButton" Theme="{StaticResource KelpieCaptionButton}"
                      WindowDecorationProperties.ElementRole="MaximizeButton" ToolTip.Tip="Maximise">
                <Path Name="MaximizeGlyph" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Width="10" Height="10" Stretch="None" StrokeThickness="1" Stroke="{Binding $parent[Button].Foreground}" />
              </Button>
              <Button Name="PART_CloseButton" Classes="close" Theme="{StaticResource KelpieCaptionButton}"
                      WindowDecorationProperties.ElementRole="CloseButton" ToolTip.Tip="Close">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stretch="None" StrokeThickness="1" Stroke="{Binding $parent[Button].Foreground}" />
              </Button>
            </StackPanel>
          </WindowDrawnDecorationsContent.Overlay>
        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>
    <Style Selector="^:maximized /template/ Path#MaximizeGlyph">
      <Setter Property="Data" Value="M2.5,0.5 L9.5,0.5 L9.5,7.5 M0.5,2.5 L7.5,2.5 L7.5,9.5 L0.5,9.5 Z" />
    </Style>
    <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
