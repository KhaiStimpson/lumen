      <SolidColorBrush x:Key="Diff.Added.Sign" Color="#1D7A3A" />
      <SolidColorBrush x:Key="Diff.Removed.Bg" Color="#FAF0EF" />
      <SolidColorBrush x:Key="Diff.Removed.Gutter" Color="#F8E9E8" />
      <SolidColorBrush x:Key="Diff.Removed.Sign" Color="#B42318" />
      <SolidColorBrush x:Key="Diff.Hunk.Bg" Color="#F3F3F3" />
      <SolidColorBrush x:Key="Diff.Hunk.Text" Color="#6B6B6B" />
