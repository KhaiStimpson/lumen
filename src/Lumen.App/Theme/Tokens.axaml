      <SolidColorBrush x:Key="Severity.High" Color="#B42318" />
      <SolidColorBrush x:Key="Severity.High.Soft" Color="#F7E8E7" />
      <SolidColorBrush x:Key="Severity.Medium" Color="#8A5700" />
      <SolidColorBrush x:Key="Severity.Medium.Soft" Color="#F5EFE5" />
      <SolidColorBrush x:Key="Severity.Low" Color="#4D4D4D" />
      <SolidColorBrush x:Key="Severity.Low.Soft" Color="#E8E8E8" />

      <SolidColorBrush x:Key="Marker.Correctness" Color="#B42318" />
      <SolidColorBrush x:Key="Marker.Deviation" Color="#8A5700" />
      <SolidColorBrush x:Key="Marker.Behaviour" Color="#0A64C8" />
      <SolidColorBrush x:Key="Marker.Architecture" Color="#7A3FC4" />
      <SolidColorBrush x:Key="Marker.Verified" Color="#1D7A3A" />

      <SolidColorBrush x:Key="Compare.Current.Bg" Color="#FAFAFA" />
      <SolidColorBrush x:Key="Compare.Current.Border" Color="#C6C6C6" />
      <SolidColorBrush x:Key="Compare.Current.Title" Color="#B42318" />
      <SolidColorBrush x:Key="Compare.Precedent.Bg" Color="#FAFAFA" />
      <SolidColorBrush x:Key="Compare.Precedent.Border" Color="#C6C6C6" />
      <SolidColorBrush x:Key="Compare.Precedent.Title" Color="#1D7A3A" />
      <SolidColorBrush x:Key="Card.Deviation.Border" Color="#C6C6C6" />
      <SolidColorBrush x:Key="Card.Deviation.Bg" Color="#F3F3F3" />
      <SolidColorBrush x:Key="Shadow" Color="#26000000" />
      <StreamGeometry x:Key="Icon.Refresh">M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M12.5,1.5 L12.5,4.5 L9.5,4.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M8,3 L8,13 M3,8 L13,8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Commit">M8,5.5 A2.5,2.5 0 1 1 7.99,5.5 Z M1,8 L5.5,8 M10.5,8 L15,8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Split">M2,2.5 L14,2.5 L14,13.5 L2,13.5 Z M8,2.5 L8,13.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Risk">M8,1.5 L14.5,8 L8,14.5 L1.5,8 Z M8,5 L8,8.8 M8,10.6 L8,11</StreamGeometry>
  <StreamGeometry x:Key="Icon.Tray">M1.5,9 L4.5,2.5 L11.5,2.5 L14.5,9 L14.5,13.5 L1.5,13.5 Z M1.5,9 L5.5,9 L6.5,11 L9.5,11 L10.5,9 L14.5,9</StreamGeometry>
  <StreamGeometry x:Key="Icon.Map">M1.5,3.5 L5.5,2 L10.5,3.5 L14.5,2 L14.5,12.5 L10.5,14 L5.5,12.5 L1.5,14 Z M5.5,2 L5.5,12.5 M10.5,3.5 L10.5,14</StreamGeometry>
    </ResourceDictionary>

