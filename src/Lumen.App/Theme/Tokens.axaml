  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI Variable, fonts:Inter#Inter, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="CodeFont">Cascadia Code, Cascadia Mono, JetBrains Mono, Consolas, Menlo, monospace</FontFamily>
  <x:Double x:Key="CodeFontSize">12</x:Double>
  <CornerRadius x:Key="Radius.Card">4</CornerRadius>
  <CornerRadius x:Key="Radius.Control">3</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">3</CornerRadius>

  <!-- Icon geometries (16×16 grid). Shapes differ by meaning so markers never rely on colour alone (TDD §28). -->
  <StreamGeometry x:Key="Icon.Deviation">M8,1.5 L14.5,13.5 L1.5,13.5 Z M7.25,5.5 L8.75,5.5 L8.6,9.6 L7.4,9.6 Z M8,10.6 A0.9,0.9 0 1 1 7.99,10.6 Z</StreamGeometry>
