      <SolidColorBrush x:Key="Accent.Soft" Color="#1A0A64C8" />
      <SolidColorBrush x:Key="Accent.OnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Diff.Added.Bg" Color="#EBF3ED" />
