<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens: the Gauge design system (KhaiStimpson/gauge-design-kit, tokens.json), used by every Kelpie app.
    Neutral greys do the structural work; one accent covers links, focus and the primary action; colour is reserved
    for meaning and that meaning is always also written as text. Gauge.* keys carry the Gauge role names; the older
    app keys below them map onto those roles. Change a colour in tokens.json first, then here, and re-run
    check-contrast.py. Kelpie brand colours (rust, cream) never appear in the app UI.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Kelpie brand lockup: only on empty states and About (dark lockup on dark surfaces) -->
      <ImageBrush x:Key="Brand.Lockup" Source="avares://Lumen/Assets/kelpie-lockup.png" Stretch="Uniform" />
      <Color x:Key="WindowColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="Gauge.Bg0" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Gauge.Bg1" Color="#FAFAFA" />
      <SolidColorBrush x:Key="Gauge.Bg2" Color="#F3F3F3" />
      <SolidColorBrush x:Key="Gauge.Bg3" Color="#E8E8E8" />
      <SolidColorBrush x:Key="Gauge.Bg4" Color="#DCDCDC" />
      <SolidColorBrush x:Key="Gauge.Line" Color="#E1E1E1" />
      <SolidColorBrush x:Key="Gauge.Line2" Color="#C6C6C6" />
      <SolidColorBrush x:Key="Gauge.LineCtl" Color="#858585" />
      <SolidColorBrush x:Key="Gauge.Fg0" Color="#1B1B1B" />
      <SolidColorBrush x:Key="Gauge.Fg1" Color="#2F2F2F" />
      <SolidColorBrush x:Key="Gauge.Fg2" Color="#4D4D4D" />
      <SolidColorBrush x:Key="Gauge.Fg3" Color="#6B6B6B" />
      <SolidColorBrush x:Key="Gauge.Accent" Color="#0A64C8" />
      <SolidColorBrush x:Key="Gauge.AccentInk" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Gauge.Sel" Color="#D6E6F8" />
      <SolidColorBrush x:Key="Gauge.SelFg" Color="#1B1B1B" />
      <SolidColorBrush x:Key="Gauge.SelEdge" Color="#0A64C8" />
      <SolidColorBrush x:Key="Gauge.Crit" Color="#B42318" />
      <SolidColorBrush x:Key="Gauge.Warn" Color="#8A5700" />
      <SolidColorBrush x:Key="Gauge.Ok" Color="#1D7A3A" />
      <SolidColorBrush x:Key="Gauge.Code" Color="#7A3FC4" />
      <SolidColorBrush x:Key="Gauge.Scrim" Color="#40000000" />

      <SolidColorBrush x:Key="Surface.Window" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface.Pane" Color="#FAFAFA" />
      <SolidColorBrush x:Key="Surface.Raised" Color="#FAFAFA" />
      <SolidColorBrush x:Key="Surface.Chrome" Color="#F3F3F3" />
      <SolidColorBrush x:Key="Surface.Sunken" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface.Control" Color="#E8E8E8" />
      <SolidColorBrush x:Key="Surface.Hover" Color="#E8E8E8" />
      <SolidColorBrush x:Key="Surface.Active" Color="#DCDCDC" />
      <SolidColorBrush x:Key="Surface.Selected" Color="#D6E6F8" />
      <SolidColorBrush x:Key="Border.Subtle" Color="#E1E1E1" />
      <SolidColorBrush x:Key="Border.Strong" Color="#C6C6C6" />
      <SolidColorBrush x:Key="Border.Control" Color="#858585" />
      <SolidColorBrush x:Key="Text.Primary" Color="#1B1B1B" />
      <SolidColorBrush x:Key="Text.Body" Color="#2F2F2F" />
      <SolidColorBrush x:Key="Text.Secondary" Color="#4D4D4D" />
      <SolidColorBrush x:Key="Text.Tertiary" Color="#6B6B6B" />
      <SolidColorBrush x:Key="Selection.Text" Color="#1B1B1B" />
      <SolidColorBrush x:Key="Selection.Edge" Color="#0A64C8" />
      <SolidColorBrush x:Key="Selection.Crit" Color="#B42318" />
      <SolidColorBrush x:Key="Selection.Warn" Color="#8A5700" />
      <!-- Fluent focus visual: Gauge focus is a 2px accent ring -->
      <Color x:Key="FocusStrokeColorOuter">#0A64C8</Color>
      <Color x:Key="FocusStrokeColorInner">#FFFFFF</Color>
      <SolidColorBrush x:Key="Accent" Color="#0A64C8" />
