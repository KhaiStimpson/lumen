      <SolidColorBrush x:Key="Find.Current" Color="#AAE0A020" />
      <SolidColorBrush x:Key="Code.LineNumber" Color="#6B6B6B" />
      <SolidColorBrush x:Key="Ruler.Thumb" Color="#1C1B1B1B" />
